# PostgreSQL
POSTGRES_DB=oil_reports
POSTGRES_USER=oil_user
POSTGRES_PASSWORD=oil_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg2://oil_user:oil_password@postgres:5432/oil_reports
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
UPLOAD_DIR=/app/tmp_uploads
SESSION_TTL_HOURS=24
